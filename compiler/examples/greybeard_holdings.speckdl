// greybeard_holdings.speckdl — Top-level compiled business.
//
// Phase 0 behavior design. Four design principles that govern every
// subsequent state machine. The watch-agent, MSA tracker, contractor
// onboarding, payroll trigger, etc. all import this spec and inherit
// its constraints.
//
// Runtime surface (tickets, integrations, capability contracts, the
// ticket lifecycle, the human queue) lives in the Java/Camel route at
// ~/.hermes/work/scobleclaw/camel-routes/greybeard-business/.
// The .speckdl is the behavior contract; the Java route is the
// operator. Two surfaces, one source of truth.
//
// Phase 3 product seed: the same spec is the customer-facing entry
// point when Greybeard Holdings resells the compiled agent suite to
// other NV S-corp founders. Parametrize via config, not via type
// ossification on the function signature.

speck GreybeardHoldings {
  version: "0.1.0"
  author: "Scott Scoble"
  source: architecture_review ref "greybeard-phase-0-2026-08-11"
  review: manual

  // ─── Entity Facts ───────────────────────────────────────────────
  // These are the facts that anchor the compiled business. Replace
  // with customer-specific values when this spec is reused for a
  // Phase 3 customer.

  type EntityFacts = {
    legalName: String,
    taxClassification: String,        // "S-corp", "C-corp", "LLC"
    stateOfFormation: String,         // "NV"
    ein: String,
    bankProvider: String,             // "Mercury"
    ownerIsRegisteredAgent: Bool,
    has1099Contractors: Bool,
    hasW2Employees: Bool
  }

  // ─── Seam Taxonomy ──────────────────────────────────────────────
  // From the principle: humans at underdetermined seams, agents at
  // determined seams. Indeterminate is a compilation failure mode.

  interface SeamType {
    Determined                       // Agent handles
    Underdetermined                  // Human handles
  }

  type SeamOf = {
    actionName: String,
    seam: SeamType
  }

  // DeadManSwitch — the alarm that fires when a state machine has
  // been silent on a deadline for too long. Triggered everywhere a
  // missing alert would otherwise replicate the silent-failure bug
  // that caused the original $120K IRS problem.

  type DeadManSwitch = {
    name: String,
    lastFiredAt: String,             // RFC3339
    maxSilentSeconds: Nat
  }

  // ─── State ──────────────────────────────────────────────────────
  // At the top level we only hold the static entity facts and the
  // registered seam-of map. Individual state machines (WatchAgent,
  // MSARenewalTracker, etc.) own their own dynamic state and import
  // this speck.

  state: {
    facts: EntityFacts,
    seamRegistry: Map<String, SeamType>,
    deadManSwitches: Map<String, DeadManSwitch>
  }

  init: {
    facts := null,
    seamRegistry := Map.empty(),
    deadManSwitches := Map.empty()
  }

  // ─── Constraints (P1: facts must be declared, not inferred) ────

  constraint: facts != null
  constraint: facts.ein != ""
  constraint: facts.stateOfFormation == "NV"
  constraint: facts.taxClassification in { "S-corp", "C-corp", "LLC" }

  // ─── Verification Conditions ────────────────────────────────────
  // The four design principles, expressed as properties the spec
  // must hold. The compiler checks them at compile time; any state
  // machine that violates P1-P4 will fail to compile when it tries
  // to import this speck.

  // P1: Facts must be declared explicitly in the facts record.
  //     No inference from runtime behavior. The facts record is the
  //     only facts the compiled business knows about.
  verify: always(facts != null)

  // P2: Function-first. The seam registry must list every action
  //     the compiled business can take. Adding an action without
  //     registering its seam is a compile error.
  verify: always(
    forall actionName in seamRegistry.keys():
      actionName != ""
  )

  // P3: Multi-tenant from day one. The compiled business must be
  //     parameterizable per customer. The entity facts record is
  //     the parameterization surface; every state machine consumes
  //     it rather than holding its own.
  verify: always(facts.ein != "")

  // P4: No Indeterminate seams. This is the invariant that
  //     converts the human/agent seam principle into a hard
  //     verification condition. The compiler's type system makes
  //     Indeterminate unrepresentable; any state machine that
  //     tries to introduce it fails to compile.
  verify: always(
    forall s in seamRegistry.values():
      s == Determined or s == Underdetermined
  )

  // ─── Dead-Man Switch (silent failure mode) ──────────────────────
  // The watch-agent fires this whenever it has been silent for too
  // long. The principle: a missing alert is itself an alert.

  action RegisterDeadManSwitch(name: String, maxSilentSeconds: Nat) {
    require length(name) >= 1
    require maxSilentSeconds > 0
    require not deadManSwitches.has(name)
    let sw := DeadManSwitch {
      name: name,
      lastFiredAt: Date.now(),
      maxSilentSeconds: maxSilentSeconds
    }
    deadManSwitches[name] := sw
  }

  action FireDeadManSwitch(name: String) {
    require deadManSwitches.has(name)
    let sw := deadManSwitches[name]
    sw.lastFiredAt := Date.now()
    deadManSwitches[name] := sw
    emit DeadManSwitchFired {
      name: name,
      firedAt: sw.lastFiredAt,
      maxSilentSeconds: sw.maxSilentSeconds
    }
  }

  // ─── Principle Archive ──────────────────────────────────────────
  // The provenance block is the principle archive. Each
  // design_decision records a principle with a rationale. The future
  // reader (Scott, in a year) can read the spec and understand why
  // the business works the way it does.
  //
  // Runtime principles (capability contracts, tickets, integrations,
  // the human queue) live in the Java/Camel route, not the spec. The
  // spec owns behavior; the route owns operations.

  provenance {
    design_decision: "Capability-typed, not identity-typed" :: "Identity-based signoff is a trust claim; capability-based signoff is a verifiable claim. The compiled business cannot trust, only verify. Job titles and roles are removed; what matters is what the business can do, not who is on the roster."
    design_decision: "Black-Scholes framing for approval" :: "Each capability is a hedge against activity risk. The compiled business prices the cheapest portfolio to bring all open risks below strike using the Black-Scholes model for options. The model is the scaffold; the implementation is the Java/Camel route."
    design_decision: "Public data source for market comps" :: "Stale market data is worse than no data. The compiled business sources market comps from continuously-updated public sources (CourtListener, state licensing boards, IRS Tax Court). Phase 0 is too inaccurate for static data; the data source is a Phase 1 pluggable."
    design_decision: "RiskAcceptance has an expiration" :: "Expirations are derived from the data source, not picked by humans. Statistical expiration (price drift) and case-driven expiration (adverse legal rulings) trigger re-pricing. The human reviews the new price; the compiled business cannot auto-renew."
    design_decision: "Hybrid model for legal analysis" :: "The agent handles retrieval and pattern matching; the human handles metacognition. The compiled business cannot simulate metacognition. The agent flags its own calibration; the human reviews what the agent flags."
    design_decision: "Indeterminate is a compilation failure" :: "Every seam is either Determined or Underdetermined. The compiled business cannot have an undecided state. The verification condition is hard: any state machine that introduces an Indeterminate seam fails to compile."
    design_decision: "Solopreneur capability absorption" :: "The compiled business serves the solopreneur by decomposing activities into capability requirements and listing the procedures. The human executes; the agent validates; the compiled business records. The absorbed knowledge is the product."
    design_decision: "Procedure as a ticket system" :: "A procedure is a recipe; a ticket is a template instance. The compiled business is a ticket system with integrations. The human's queue is the unresolved-seams list. The compiled business generates tickets; the integrations execute subtasks; the human resolves seams."
    design_decision: "P75 as the market comp reference" :: "Below market is suspicious; above market is spendy. The 75th percentile is the right positioning for sabermetric, non-emotional pricing. The compiled business flags over-priced and suspiciously-cheap contracts as anomalies."
    design_decision: "Underdetermined seams are small for data-driven accounting" :: "The IRS rules are published; the formulas are deterministic. The only underdetermined parts are reasonable compensation (within an IRS range) and payment method. The compiled business tells the human what to do; the human decides the small set of underdetermined seams."
    design_decision: "Speckl is the behavior design surface, Java/Camel is the runtime" :: "The .speckdl captures the contract — what the system does and why. The Java/Camel route executes the contract — how the system actually runs. Two surfaces, one source of truth. The spec is small; the runtime can be large."
    design_decision: "Behavioral parity between AI and Human" :: "The seam (Determined | Underdetermined) is metadata that drives the dynamic router — which enrichment path the signal takes — NOT a gate that rejects or DLQs the signal. The same body from a human (no seam_type, defaulted to underdetermined) and from an agent (seam_type=determined) must produce the same idempotency key and land in the same row. Whether AI or Human executes on the envelope isn't part of parity."
    design_decision: "Per-seam dead-man-switch SLA" :: "AI (Determined) acks within seconds (30s default); Human (Underdetermined) acks within hours (24h default). The DeadManSwitch.maxSilentSeconds field is per-switch, not global. The DLQ sweep uses the seam-specific threshold when scanning for expired entries."
    design_decision: "Dynamic router enriches after routing" :: "After the P2/P3 gates decide destination=resolved, the dynamic router reads the seam and dispatches to the AI enrichment path (compact JSON, structured action_type, dead-man-switch handle with 30s SLA) or the Human enrichment path (prose summary, human-readable deadline, source link, suggested-action text, 24h SLA). Both paths terminate in the same persistence — the row in greybeard_signal_audit is identical regardless of seam."
  }
}
