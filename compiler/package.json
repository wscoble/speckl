{
  "name": "speckl",
  "version": "0.4.0",
  "description": "Speckl compiler for SpeckDL specs: TypeScript, Rust, Go, Z3, Protobuf, K8s CRDs, OpenAPI, agent rails (Claude Code, Cursor, Codex, Gemini) and SBOM artifacts with embedded provenance",
  "keywords": [
    "speckl",
    "speckdl",
    "specification",
    "state-machine",
    "formal-verification",
    "z3",
    "smt",
    "model-checking",
    "sbom",
    "provenance",
    "ai-agents",
    "claude-code",
    "cursor",
    "agent-guardrails"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wscoble/speckl.git"
  },
  "bugs": {
    "url": "https://github.com/wscoble/speckl/issues"
  },
  "homepage": "https://github.com/wscoble/speckl#readme",
  "bin": {
    "speckl": "./dist/index.js",
    "speckl-compile": "./dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:compile": "node scripts/test-compile.mjs",
    "verify": "node scripts/verify-z3.mjs",
    "prepublishOnly": "npm test",
    "dev": "tsc --watch",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build",
    "test:pack": "vitest run src/__tests__/package-pack.test.ts"
  },
  "dependencies": {
    "js-yaml": "^5.4.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.5",
    "@types/yargs": "^17.0.33",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.20.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
