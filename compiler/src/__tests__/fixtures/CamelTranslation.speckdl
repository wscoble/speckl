// Fixture for the Camel target: one action per translatable form, plus
// forms that must fail closed. Compiled with javac by compiles-java.test.ts.
speck CamelTranslation {
    interface Phase {
        Draft
        Review
        Done
    }

    type Account = {
        owner: String,
        balance: Int,
        phase: Phase
    }

    state {
        phase: Phase
        count: Nat
        ratio: Real
        label: String
        open: Bool
        accounts: Map(String, Account)
        balances: Map(Nat, Int)
        seen: List(Nat)
        tags: Set(String)
    }

    init {
        phase := Draft
        count := 0
        ratio := 0.5
        label := "start"
        open := true
        tags := emptySet()
    }

    event Moved {
        from: Nat,
        to: Nat,
        note: String
    }

    action Advance(step: Nat) {
        require phase == Draft
        require step > 0 and step <= 10
        count := count + step
        ratio := ratio * 2.0 + count
        label := label + "-"
        phase := Review
        emit Moved { from: count - step, to: count, note: label }
        postcondition: count >= step
    }

    action Credit(owner: String, amount: Int) {
        require has(accounts, owner)
        require owner in accounts.keys
        let a := accounts[owner]
        require a.phase != Done
        balances[count] := amount
        seen := append(seen, count)
        open := amount <= 100
    }

    action Check(id: Nat) {
        require id in seen
        require id notIn balances.keys
        require length(label) >= 1 implies open
        return min(id, count)
    }

    action Reset() {
        tags := emptySet()
        count := 0
    }

    action Unsupported(id: Nat) {
        require count >= 0
        seen := seen union { id }
        if id > 100 {
            open := false
        }
        count := count + 1
    }

    next: Advance | Credit | Check | Reset | Unsupported
}
