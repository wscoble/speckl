  "machineExport": "ClaudeCodePolicyMachine",
  "stageVariable": "stage",
  "stages": {
    "Idle": 0,
    "TestsGreen": 1,
    "AwaitingReview": 2,
    "Approved": 3,
    "Rejected": 4,
    "PrOpened": 5
  },
  "tools": [
    {
      "name": "edit_code",
      "action": "EditCode",
      "effect": "act"
    },
    {
      "name": "run_tests",
      "action": "RunTests",
      "effect": "act"
    },
    {
      "name": "request_review",
      "action": "RequestReview",
      "effect": "act"
    },
    {
      "name": "open_pr",
      "action": "OpenPR",
      "effect": "act"
    },
    {
      "name": "read_file",
      "action": "ReadFile",
      "effect": "observe"
    },
    {
      "name": "inspect",
      "action": "Inspect",
      "effect": "observe"
    }
  ],
  "pendingTimeout": {
    "durationMs": 600000,
    "durationText": "10m"
  },
  "awaits": [
    {
      "state": "AwaitingReview",
      "stateValue": 2,
      "signal": "review",
      "mode": "near",
      "outcomes": [
        "approve",
        "reject"
      ],
      "rejects": [
        "reject"
      ],
      "claims": [
        {
          "name": "reviewer",
          "typeName": "String"
        }
      ],
      "on": [
        {
          "outcome": "approve",
          "target": "Approved",
          "targetValue": 3,
          "action": "__signal_review_approve"
        },
        {
          "outcome": "reject",
          "target": "Rejected",
          "targetValue": 4,
          "action": "__signal_review_reject"
        }
      ],
      "timeout": {
        "durationMs": 86400000,
        "durationText": "24h",
        "outcome": "reject"
      },
      "bindCall": []
    }
  ],
