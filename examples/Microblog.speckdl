// Microblog.speckdl — A canonical microblogging platform, specified in Speckl.
//
// The "specify anything with provenance" demo for a social/fediverse app.
// Forces every facet the IR exposes:
//
//   - typed_schema: User, Post, Timeline, Follow relationships
//   - behavior: post, follow, unfollow, boost, reply, like
//   - formal_spec: constraints on follow graphs, post lengths, timeline bounds
//   - wire_format: ActivityPub JSON-LD for Mastodon / REST+JSON for Twitter
//   - validation: post length 1..280, screen name pattern
//   - resource_lifecycle: post status (visible/hidden/deleted), user status
//   - provenance: explicit lineage to ActivityPub RFC, OAuth 1.0a
//   - metadata: version, license
//
// Same .speckdl, different deploy target:
//   - twitter-style: REST+JSON, OAuth, single-tenant
//   - mastodon-style: ActivityPub, OAuth, federated (multiple instances)
//
// The transport difference is config, not a different spec.

speck Microblog {
  author: "wscoble"
  source: document ref "federated-meetup-canonical-spec"
  review: manual

  // ─── State ────────────────────────────────────────────────
  // Posts and follows are the persistent state. Timelines are derived
  // (computed from posts + follows) — they live in a separate "view"
  // (the persistence facet would carry that as a derived projection,
  // not as persistent state).

  state: {
    users: Map<String, User>,
    posts: Map<String, Post>,
    follows: Map<String, Follow>,
    nextPostId: Nat := 1
  }

  init: {
    users := Map.empty(),
    posts := Map.empty(),
    follows := Map.empty(),
    nextPostId := 1
  }

  // ─── Types ────────────────────────────────────────────────

  type User = {
    id: String,
    handle: String,        // @user@instance.tld for fediverse, @user for twitter
    displayName: String,
    bio: String | null,
    createdAt: Date,
    postCount: Nat,
    followerCount: Nat,
    followingCount: Nat
  }

  type Post = {
    id: String,
    authorId: String,
    body: String,          // 1..280 chars for twitter; longer for mastodon
    replyToPostId: String | null,
    boostOfPostId: String | null,  // mastodon reblog / twitter retweet
    visibility: PostVisibility,
    likeCount: Nat,
    boostCount: Nat,
    replyCount: Nat,
    createdAt: Date
  }

  type Follow = {
    followerId: String,
    followeeId: String,
    createdAt: Date
  }

  // A timeline is a derived view: a chronological list of post IDs.
  type Timeline = {
    userId: String,
    postIds: List<String>,
    lastComputedAt: Date
  }

  interface PostVisibility {
    Public
    Followers
    Direct
  }

  // ─── Post operations ─────────────────────────────────────

  action CreatePost(authorId: String, body: String) {
    require users.has(authorId)
    require length(body) >= 1
    require length(body) <= 280
    let newId := nextPostId
    nextPostId := nextPostId + 1
    let post := Post {
      id: String(newId),
      authorId: authorId,
      body: body,
      replyToPostId: null,
      boostOfPostId: null,
      visibility: Public,
      likeCount: 0,
      boostCount: 0,
      replyCount: 0,
      createdAt: Date.now()
    }
    posts[String(newId)] := post
  }

  action BoostPost(userId: String, originalPostId: String) {
    require users.has(userId)
    require posts.has(originalPostId)
    let newId := nextPostId
    nextPostId := nextPostId + 1
    let boost := Post {
      id: String(newId),
      authorId: userId,
      body: posts[originalPostId].body,
      replyToPostId: null,
      boostOfPostId: originalPostId,
      visibility: Public,
      likeCount: 0,
      boostCount: 0,
      replyCount: 0,
      createdAt: Date.now()
    }
    posts[String(newId)] := boost
    let original := posts[originalPostId]
    original.boostCount := original.boostCount + 1
    posts[originalPostId] := original
  }

  action ReplyToPost(userId: String, parentPostId: String, body: String) {
    require users.has(userId)
    require posts.has(parentPostId)
    require length(body) >= 1
    let newId := nextPostId
    nextPostId := nextPostId + 1
    let reply := Post {
      id: String(newId),
      authorId: userId,
      body: body,
      replyToPostId: parentPostId,
      boostOfPostId: null,
      visibility: Public,
      likeCount: 0,
      boostCount: 0,
      replyCount: 0,
      createdAt: Date.now()
    }
    posts[String(newId)] := reply
    let parent := posts[parentPostId]
    parent.replyCount := parent.replyCount + 1
    posts[parentPostId] := parent
  }

  // ─── Follow graph ────────────────────────────────────────

  action Follow(followerId: String, followeeId: String) {
    require users.has(followerId)
    require users.has(followeeId)
    require followerId != followeeId
    let key := followerId + ":" + followeeId
    let follow := Follow {
      followerId: followerId,
      followeeId: followeeId,
      createdAt: Date.now()
    }
    follows[key] := follow
    let f := users[followeeId]
    f.followerCount := f.followerCount + 1
    users[followeeId] := f
    let g := users[followerId]
    g.followingCount := g.followingCount + 1
    users[followerId] := g
  }

  action Unfollow(followerId: String, followeeId: String) {
    require follows.has(followerId + ":" + followeeId)
    follows.remove(followerId + ":" + followeeId)
    let f := users[followeeId]
    f.followerCount := f.followerCount - 1
    users[followeeId] := f
    let g := users[followerId]
    g.followingCount := g.followingCount - 1
    users[followerId] := g
  }

  // ─── User operations ─────────────────────────────────────

  action CreateUser(handle: String, displayName: String) {
    require length(handle) >= 1
    require length(displayName) >= 1
    let id := handle
    let user := User {
      id: id,
      handle: handle,
      displayName: displayName,
      bio: null,
      createdAt: Date.now(),
      postCount: 0,
      followerCount: 0,
      followingCount: 0
    }
    users[id] := user
  }

  // ─── Service definition ──────────────────────────────────
  // The transport surface. Note: the RPC signatures are the same
  // for twitter and mastodon — the transport is config.

  service MicroblogService {
    rpc CreatePost (CreatePostRequest) returns (Post);
    rpc BoostPost (BoostPostRequest) returns (Post);
    rpc ReplyToPost (ReplyToPostRequest) returns (Post);
    rpc Follow (FollowRequest) returns (Follow);
    rpc Unfollow (UnfollowRequest) returns (Follow);
    rpc CreateUser (CreateUserRequest) returns (User);
    rpc GetTimeline (GetTimelineRequest) returns (Timeline);
  }

  // ─── Wire format ──────────────────────────────────────────
  // mastodon uses ActivityPub JSON-LD; twitter uses REST+JSON.
  // Both can be expressed as protobuf for transport between
  // services in our own infrastructure; the spec is the same.

  proto_package: "microblog.v1"
  go_package: "github.com/wscoble/microblog/proto/microblog/v1;microblogv1"
  event_suffix: "Request"

  // ─── Resource lifecycle ──────────────────────────────────
  // Posts have visibility state; users have account state.

  status: { ready: Bool, postCount: Nat, followerCount: Nat }
  conditions: ["Ready", "Federated", "Suspended"]
  finalizers: ["cleanup-deleted-posts"]
  ownerReferences: false

  // ─── Formal spec ─────────────────────────────────────────
  // Spec-level invariants on the follow graph and post state.

  constraint "no self-follows" {
    forall f in follows.values(): f.followerId != f.followeeId
  }

  constraint "post body length is bounded" {
    forall p in posts.values(): length(p.body) >= 1 && length(p.body) <= 280
  }

  // ─── Provenance ──────────────────────────────────────────
  // The spec is derived from ActivityPub (W3C) and Twitter API v2.
  // Both shape choices are explicit.

  provenance {
    parent_spec "Blog.speckdl"
    external_doc "ActivityPub W3C Recommendation" :: "https://www.w3.org/TR/activitypub/"
    external_doc "Twitter API v2 Reference" :: "https://developer.twitter.com/en/docs/twitter-api"
    design_decision "timeline is a derived view, not persistent state" :: "matches both ActivityPub OrderedCollection and Twitter timeline behavior"
    design_decision "post body capped at 280 chars" :: "twitter compatibility; mastodon deployments override via config"
  }

  // ─── BOM metadata ─────────────────────────────────────────

  bom {
    compiler { name: "speckl", version: "0.3.0" }
    runtime { name: "node", version: "20" }
    license: "MIT"
  }
}
