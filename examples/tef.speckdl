// tef.speckdl — The TEF Engine API, specified in Speckl.
//
// This is the canonical workload that proves Speckl can express production
// Kubernetes CRD infrastructure. All 8 TEF CRDs are defined here as a single
// Speckl spec. The K8s CRD target (next on the list) will compile this spec
// to actual `CustomResourceDefinition` YAML. Until then, the Go types in
// `/home/sscoble/projects/tef-engine/api/v1alpha1/*.go` are the human-
// reference for field semantics — this spec must match them field-by-field.
//
// The 8 CRDs in this spec:
//   1. Customer         — A tenant of the TEF engine
//   2. Product          — A build target, the core work item
//   3. Spec             — A specification for a Product
//   4. Flow             — A Speckl-shaped state machine driving a Product's lifecycle
//   5. AcceptanceContract — Rules a Product must satisfy to be accepted
//   6. BuildJob         — A sequential build pipeline for a Product
//   7. Integration      — External service connection (github, slack, webhook)
//   8. Evaluator        — Post-build validation step (lint, security-scan, etc.)
//
// Each CRD follows the K8s pattern: TypeMeta + ObjectMeta + Spec + Status.
// The wire_format is protobuf (for service-to-service) AND CRD YAML (for K8s).
// The provenance block carries the lineage to the upstream specs.
//
// See OB1 #3642 for the "specify anything with provenance" thesis.
// See TEF Engine repo for the current Go implementation this is derived from.

speck TEF {
  version: "0.1.2"
  author: "sscoble"
  source: architecture_review ref "tef-crd-spec-2026-07-19"
  review: hybrid

  // ─── K8s Object Metadata (shared by all CRDs) ────────────────────
  // Subset of metav1.ObjectMeta that TEF CRDs actually use.

  type TypeMeta = {
    kind: String,
    apiVersion: String
  }

  type ObjectMeta = {
    name: String,                    // RFC1123 subdomain
    namespace: String,               // K8s namespace
    uid: String,                     // K8s-assigned unique ID
    resourceVersion: String,         // K8s resource version
    generation: Int,                 // Spec generation counter
    creationTimestamp: Date,         // When the resource was created
    labels: Map<String, String>,     // K8s labels
    annotations: Map<String, String> // K8s annotations
  }

  type ListMeta = {
    resourceVersion: String,
    continue_: String                // Pagination token (avoids reserved word)
  }

  // ─── Cross-cutting types ─────────────────────────────────────────

  // Transition — a single allowed state transition in a Flow.
  type Transition = {
    from: String,                    // Source state name
    to: String,                      // Destination state name
    event: String,                   // Event that triggers this transition
    guard: String | null             // Optional guard identifier
  }

  // TransitionRecord — audit log entry in a Flow's status.
  type TransitionRecord = {
    from: String,
    to: String,
    event: String,
    timestamp: String                // RFC3339
  }

  // Rule — a single acceptance or build rule. Expression is a shell command
  // string in v1 (TODO: real evaluator in later slice).
  type Rule = {
    name: String,
    expression: String
  }

  // AcceptanceResult — outcome of running one acceptance rule.
  type AcceptanceResult = {
    name: String,
    expression: String,
    pass: Bool,
    error: String | null
  }

  // BuildResult — outcome of running one build step.
  type BuildResult = {
    name: String,
    expression: String,
    pass: Bool,
    error: String | null
  }

  // BuildStep — one step in a BuildJob. Runs sequentially as a shell command.
  type BuildStep = {
    name: String,
    command: String,                 // Shell command
    env: List<EnvVar> | null         // Optional env vars
  }

  // EnvVar — K8s-style environment variable.
  type EnvVar = {
    name: String,
    value: String,
    valueFrom: EnvVarSource | null
  }

  type EnvVarSource = {
    secretKeyRef: SecretKeySelector | null,
    configMapKeyRef: ConfigMapKeySelector | null
  }

  type SecretKeySelector = {
    name: String,
    key: String,
    optional: Bool
  }

  type ConfigMapKeySelector = {
    name: String,
    key: String,
    optional: Bool
  }

  // BuildStepResult — outcome of one build step (used in BuildJobStatus).
  type BuildStepResult = {
    name: String,
    exitCode: Int,
    stdout: String | null,           // Truncated for status
    stderr: String | null,           // Truncated for status
    duration: String | null          // Wall-clock, e.g. "1.234s"
  }

  // ─── Enum types ─────────────────────────────────────────────────

  // ProductPhase — high-level lifecycle phase of a Product.
  interface ProductPhase {
    Building                      // Product is being built/derived from its spec
    Ready                         // Product is ready for acceptance checks
    Shipped                       // Product has been accepted and shipped (TOML written)
    Rejected                      // An acceptance rule failed
  }

  // BuildJobPhase — lifecycle phase of a BuildJob.
  interface BuildJobPhase {
    Pending
    Running
    Succeeded
    Failed
  }

  // EvaluatorPhase — lifecycle phase of an Evaluator run.
  interface EvaluatorPhase {
    Pending
    Running
    Succeeded
    Failed
  }

  // ─── CRD 1: Customer ─────────────────────────────────────────────
  // A tenant of the TEF engine. The engine creates per-customer namespaces
  // (future slice; slice 0 keeps everything in tef-system).

  type CustomerSpec = {
    displayName: String,            // Human-readable customer name
    owner: String,                  // Contact/owner (email or username)
    description: String | null,     // Optional free-form description
    namespace: String | null        // Per-customer namespace (future slice)
  }

  type CustomerStatus = {
    namespaceReady: Bool,           // True once per-customer namespace exists
    observedGeneration: Int,        // Most recent generation observed
    message: String | null          // Human-readable status
  }

  type Customer = {
    typeMeta: TypeMeta,
    metadata: ObjectMeta,
    spec: CustomerSpec,
    status: CustomerStatus | null
  }

  // ─── CRD 2: Product ──────────────────────────────────────────────
  // A build target — the core work item. Phase transitions:
  //   Building -> Ready -> (Shipped | Rejected)

  type ProductSpec = {
    customerRef: String,            // Name of the owning Customer
    specRef: String,                // Name of the Spec defining this product
    flowRef: String | null,         // Name of the Flow driving lifecycle
    acceptanceRef: String | null,   // Name of the AcceptanceContract
    owner: String                   // Owner (e.g. username/email)
  }

  type ProductStatus = {
    phase: ProductPhase | null,     // Current lifecycle phase
    observedGeneration: Int,        // Most recent generation observed
    message: String | null,         // Human-readable status
    acceptance: List<AcceptanceResult> | null,  // Per-rule results
    buildResults: List<BuildResult> | null,    // Per-step results
    tomlPath: String | null         // Path of written TOML summary (on Shipped)
  }

  type Product = {
    typeMeta: TypeMeta,
    metadata: ObjectMeta,
    spec: ProductSpec,
    status: ProductStatus | null
  }

  // ─── CRD 3: Spec ─────────────────────────────────────────────────
  // A specification for a Product. Free-form in v1 — requirements and
  // acceptance criteria are strings. Future slices may parse these into
  // structured form.

  type SpecSpec = {
    customerRef: String,            // Name of the owning Customer
    summary: String,                // Short human-readable description
    requirements: List<String> | null,           // Free-form requirements
    acceptanceCriteria: List<String> | null     // Free-form criteria
  }

  type SpecStatus = {
    read: Bool,                     // True once the engine acknowledged the spec
    observedGeneration: Int,
    message: String | null
  }

  type Spec = {
    typeMeta: TypeMeta,
    metadata: ObjectMeta,
    spec: SpecSpec,
    status: SpecStatus | null
  }

  // ─── CRD 4: Flow ─────────────────────────────────────────────────
  // A Speckl-shaped state machine driving a Product's lifecycle.
  // States are listed explicitly; transitions are (from, to, event, guard?).

  type FlowSpec = {
    states: List<String>,           // Ordered list of state names
    initialState: String,           // Where the machine starts
    transitions: List<Transition> | null,
    customerRef: String,            // Owning Customer
    productRef: String | null,      // Product this flow drives
    specRef: String | null,         // Associated Spec
    acceptanceRef: String | null    // Associated AcceptanceContract
  }

  type FlowStatus = {
    currentState: String | null,    // Current state of the machine
    history: List<TransitionRecord> | null,  // Append-only audit log
    observedGeneration: Int,
    message: String | null
  }

  type Flow = {
    typeMeta: TypeMeta,
    metadata: ObjectMeta,
    spec: FlowSpec,
    status: FlowStatus | null
  }

  // ─── CRD 5: AcceptanceContract ──────────────────────────────────
  // Rules a Product must satisfy. TargetKind is the resource kind rules
  // run against (for v1, always "Product"). BuildSteps run BEFORE
  // acceptance; if absent, the build phase is skipped.

  type AcceptanceContractSpec = {
    customerRef: String,            // Owning Customer
    targetKind: String,             // Resource kind rules run against
    rules: List<Rule> | null,       // Acceptance rules
    buildSteps: List<Rule> | null   // Build steps (run before acceptance)
  }

  type AcceptanceContractStatus = {
    lastEvaluated: String | null,   // RFC3339 timestamp
    observedGeneration: Int,
    message: String | null
  }

  type AcceptanceContract = {
    typeMeta: TypeMeta,
    metadata: ObjectMeta,
    spec: AcceptanceContractSpec,
    status: AcceptanceContractStatus | null
  }

  // ─── CRD 6: BuildJob ────────────────────────────────────────────
  // A sequential build pipeline for a Product. Each step is a shell command
  // run inside a worker container. The build job controller reconciles the
  // Product to the appropriate phase based on step outcomes.

  type BuildJobSpec = {
    productRef: String,             // Owning Product
    steps: List<BuildStep>,         // Steps run sequentially
    pvc: String | null,             // Optional PVC for results storage
    serviceAccount: String | null,  // Defaults to tef-buildjob
    image: String | null,           // Defaults to engine image
    nodeName: String | null         // Defaults to control plane node
  }

  type BuildJobStatus = {
    phase: BuildJobPhase | null,    // Current lifecycle phase
    results: List<BuildStepResult> | null,  // Per-step results
    message: String | null,
    observedGeneration: Int
  }

  type BuildJob = {
    typeMeta: TypeMeta,
    metadata: ObjectMeta,
    spec: BuildJobSpec,
    status: BuildJobStatus | null
  }

  // ─── CRD 7: Integration ─────────────────────────────────────────
  // External service connection (github, slack, webhook). Declared in v0.1.2
  // but not yet reconciled by the engine. Future slices will wire it up.

  type IntegrationSpec = {
    customerRef: String,            // Owning Customer
    type_: String,                  // Integration type: "github", "slack", "webhook"
    config: Map<String, String> | null  // Opaque config (free-form for v1)
  }

  type IntegrationStatus = {
    connected: Bool,                // True once the integration is live
    observedGeneration: Int,
    message: String | null
  }

  type Integration = {
    typeMeta: TypeMeta,
    metadata: ObjectMeta,
    spec: IntegrationSpec,
    status: IntegrationStatus | null
  }

  // ─── CRD 8: Evaluator ───────────────────────────────────────────
  // External validation step run after a Product is built. Declarative in
  // v0.1.2 (registered, visible via `kubectl get evaluator`); controller
  // will wire up actual evaluation in v0.1.3.

  type EvaluatorSpec = {
    name: String,                   // Human-readable name (e.g. "lint")
    image: String,                  // Container image to run
    command: String | null,         // Command to execute inside the image
    timeoutSeconds: Int | null,     // Max wall-clock time
    customerRef: String             // Owning Customer
  }

  type EvaluatorStatus = {
    phase: EvaluatorPhase | null,   // Current lifecycle phase
    lastRun: String | null,         // RFC3339 timestamp
    result: String | null           // Human-readable result (e.g. "pass")
  }

  type Evaluator = {
    typeMeta: TypeMeta,
    metadata: ObjectMeta,
    spec: EvaluatorSpec,
    status: EvaluatorStatus | null
  }

  // ─── State ──────────────────────────────────────────────────────
  // Engine-level state. The engine watches all CRDs and reconciles them
  // into consistent state across the cluster. This is a logical model of
  // what the engine maintains in memory + on disk.

  state: {
    customers: Map<String, Customer>,
    products: Map<String, Product>,
    specs: Map<String, Spec>,
    flows: Map<String, Flow>,
    acceptanceContracts: Map<String, AcceptanceContract>,
    buildJobs: Map<String, BuildJob>,
    integrations: Map<String, Integration>,
    evaluators: Map<String, Evaluator>
  }

  init: {
    customers := Map.empty(),
    products := Map.empty(),
    specs := Map.empty(),
    flows := Map.empty(),
    acceptanceContracts := Map.empty(),
    buildJobs := Map.empty(),
    integrations := Map.empty(),
    evaluators := Map.empty()
  }

  // ─── Actions ────────────────────────────────────────────────────
  // The engine's reconciler actions, modeled as Speckl actions.
  // These are the operations the engine performs on its own state in
  // response to CRD events.

  action CreateCustomer(name: String, displayName: String, owner: String, description: String | null) {
    require length(name) >= 1
    require length(displayName) >= 1
    require length(owner) >= 1
    require not customers.has(name)
    let c := Customer {
      typeMeta: TypeMeta { kind: "Customer", apiVersion: "tef.scoble.me/v1alpha1" },
      metadata: ObjectMeta {
        name: name,
        namespace: "tef-system",
        uid: name + "-uid",
        resourceVersion: "1",
        generation: 1,
        creationTimestamp: Date.now(),
        labels: Map.empty(),
        annotations: Map.empty()
      },
      spec: CustomerSpec {
        displayName: displayName,
        owner: owner,
        description: description,
        namespace: null
      },
      status: null
    }
    customers[name] := c
  }

  action CreateProduct(name: String, customerRef: String, specRef: String, owner: String, flowRef: String | null, acceptanceRef: String | null) {
    require customers.has(customerRef)
    require specs.has(specRef)
    require length(name) >= 1
    require not products.has(name)
    let p := Product {
      typeMeta: TypeMeta { kind: "Product", apiVersion: "tef.scoble.me/v1alpha1" },
      metadata: ObjectMeta {
        name: name,
        namespace: "tef-system",
        uid: name + "-uid",
        resourceVersion: "1",
        generation: 1,
        creationTimestamp: Date.now(),
        labels: Map.empty(),
        annotations: Map.empty()
      },
      spec: ProductSpec {
        customerRef: customerRef,
        specRef: specRef,
        flowRef: flowRef,
        acceptanceRef: acceptanceRef,
        owner: owner
      },
      status: ProductStatus {
        phase: Building,
        observedGeneration: 1,
        message: "product created",
        acceptance: null,
        buildResults: null,
        tomlPath: null
      }
    }
    products[name] := p
  }

  action TransitionProductPhase(productName: String, newPhase: ProductPhase, message: String | null) {
    require products.has(productName)
    let p := products[productName]
    p.status.phase := newPhase
    p.status.message := message
    p.status.observedGeneration := p.status.observedGeneration + 1
    products[productName] := p
  }

  action ShipProduct(productName: String, tomlPath: String) {
    require products.has(productName)
    let p := products[productName]
    require p.status.phase == Ready
    p.status.tomlPath := tomlPath
    products[productName] := p
    transitionProductPhase(productName, Shipped, "shipped to " + tomlPath)
  }

  action RejectProduct(productName: String, reason: String) {
    require products.has(productName)
    let p := products[productName]
    transitionProductPhase(productName, Rejected, reason)
  }

  action CreateBuildJob(productName: String, steps: List<BuildStep>, image: String | null, nodeName: String | null) {
    require products.has(productName)
    let bjName := productName + "-build"
    require not buildJobs.has(bjName)
    let bj := BuildJob {
      typeMeta: TypeMeta { kind: "BuildJob", apiVersion: "tef.scoble.me/v1alpha1" },
      metadata: ObjectMeta {
        name: bjName,
        namespace: "tef-system",
        uid: bjName + "-uid",
        resourceVersion: "1",
        generation: 1,
        creationTimestamp: Date.now(),
        labels: Map.empty(),
        annotations: Map.empty()
      },
      spec: BuildJobSpec {
        productRef: productName,
        steps: steps,
        pvc: null,
        serviceAccount: null,
        image: image,
        nodeName: nodeName
      },
      status: BuildJobStatus {
        phase: Pending,
        results: null,
        message: "build job created",
        observedGeneration: 1
      }
    }
    buildJobs[bjName] := bj
  }

  action AdvanceBuildJob(buildJobName: String, newPhase: BuildJobPhase) {
    require buildJobs.has(buildJobName)
    let bj := buildJobs[buildJobName]
    bj.status.phase := newPhase
    bj.status.observedGeneration := bj.status.observedGeneration + 1
    buildJobs[buildJobName] := bj
  }

  action CreateAcceptanceContract(name: String, customerRef: String, targetKind: String, rules: List<Rule>, buildSteps: List<Rule> | null) {
    require customers.has(customerRef)
    require not acceptanceContracts.has(name)
    let ac := AcceptanceContract {
      typeMeta: TypeMeta { kind: "AcceptanceContract", apiVersion: "tef.scoble.me/v1alpha1" },
      metadata: ObjectMeta {
        name: name,
        namespace: "tef-system",
        uid: name + "-uid",
        resourceVersion: "1",
        generation: 1,
        creationTimestamp: Date.now(),
        labels: Map.empty(),
        annotations: Map.empty()
      },
      spec: AcceptanceContractSpec {
        customerRef: customerRef,
        targetKind: targetKind,
        rules: rules,
        buildSteps: buildSteps
      },
      status: null
    }
    acceptanceContracts[name] := ac
  }

  action CreateFlow(name: String, customerRef: String, states: List<String>, initialState: String, transitions: List<Transition> | null, productRef: String | null) {
    require customers.has(customerRef)
    require states.contains(initialState)
    require length(name) >= 1
    require not flows.has(name)
    let f := Flow {
      typeMeta: TypeMeta { kind: "Flow", apiVersion: "tef.scoble.me/v1alpha1" },
      metadata: ObjectMeta {
        name: name,
        namespace: "tef-system",
        uid: name + "-uid",
        resourceVersion: "1",
        generation: 1,
        creationTimestamp: Date.now(),
        labels: Map.empty(),
        annotations: Map.empty()
      },
      spec: FlowSpec {
        states: states,
        initialState: initialState,
        transitions: transitions,
        customerRef: customerRef,
        productRef: productRef,
        specRef: null,
        acceptanceRef: null
      },
      status: FlowStatus {
        currentState: initialState,
        history: null,
        observedGeneration: 1,
        message: "flow initialized"
      }
    }
    flows[name] := f
  }

  action FireFlowEvent(flowName: String, event: String) {
    require flows.has(flowName)
    let f := flows[flowName]
    let current := f.status.currentState
    let next := current
    for t in f.spec.transitions:
      if t.from == current && t.event == event:
        next := t.to
    require next != current
    f.status.currentState := next
    f.status.message := "transitioned via " + event
    f.status.observedGeneration := f.status.observedGeneration + 1
    flows[flowName] := f
  }

  action CreateIntegration(name: String, customerRef: String, type_: String, config: Map<String, String> | null) {
    require customers.has(customerRef)
    require length(name) >= 1
    require not integrations.has(name)
    let i := Integration {
      typeMeta: TypeMeta { kind: "Integration", apiVersion: "tef.scoble.me/v1alpha1" },
      metadata: ObjectMeta {
        name: name,
        namespace: "tef-system",
        uid: name + "-uid",
        resourceVersion: "1",
        generation: 1,
        creationTimestamp: Date.now(),
        labels: Map.empty(),
        annotations: Map.empty()
      },
      spec: IntegrationSpec {
        customerRef: customerRef,
        type_: type_,
        config: config
      },
      status: null
    }
    integrations[name] := i
  }

  action CreateEvaluator(name: String, customerRef: String, image: String, command: String | null, timeoutSeconds: Int | null) {
    require customers.has(customerRef)
    require length(name) >= 1
    require not evaluators.has(name)
    let e := Evaluator {
      typeMeta: TypeMeta { kind: "Evaluator", apiVersion: "tef.scoble.me/v1alpha1" },
      metadata: ObjectMeta {
        name: name,
        namespace: "tef-system",
        uid: name + "-uid",
        resourceVersion: "1",
        generation: 1,
        creationTimestamp: Date.now(),
        labels: Map.empty(),
        annotations: Map.empty()
      },
      spec: EvaluatorSpec {
        name: name,
        image: image,
        command: command,
        timeoutSeconds: timeoutSeconds,
        customerRef: customerRef
      },
      status: EvaluatorStatus {
        phase: Pending,
        lastRun: null,
        result: null
      }
    }
    evaluators[name] := e
  }

  action AdvanceEvaluator(evaluatorName: String, newPhase: EvaluatorPhase, result: String | null) {
    require evaluators.has(evaluatorName)
    let e := evaluators[evaluatorName]
    e.status.phase := newPhase
    e.status.lastRun := Date.now().toString()
    e.status.result := result
    evaluators[evaluatorName] := e
  }

  // ─── Service ────────────────────────────────────────────────────
  // The TEF service surface. Each CRD gets a Create and Get RPC. Products
  // additionally get a Status RPC for phase updates.

  service TEFService {
    rpc CreateCustomer(CreateCustomerRequest) returns (Customer);
    rpc GetCustomer(GetCustomerRequest) returns (Customer);
    rpc CreateProduct(CreateProductRequest) returns (Product);
    rpc GetProduct(GetProductRequest) returns (Product);
    rpc UpdateProductStatus(UpdateProductStatusRequest) returns (Product);
    rpc CreateBuildJob(CreateBuildJobRequest) returns (BuildJob);
    rpc CreateAcceptanceContract(CreateAcceptanceContractRequest) returns (AcceptanceContract);
    rpc CreateFlow(CreateFlowRequest) returns (Flow);
    rpc FireFlowEvent(FireFlowEventRequest) returns (Flow);
    rpc CreateIntegration(CreateIntegrationRequest) returns (Integration);
    rpc CreateEvaluator(CreateEvaluatorRequest) returns (Evaluator);
  }

  // ─── Wire format ────────────────────────────────────────────────

  proto_package: "tef.v1alpha1"
  go_package: "github.com/sscoble/tef-engine/api/v1alpha1;v1alpha1"
  event_suffix: "Request"
  // K8s CRD target: the API group for CustomResourceDefinitions.
  // Defaults to the first segment of proto_package if not specified.
  k8s_group: "tef.scoble.me"
  k8s_version: "v1alpha1"

  // ─── Resource lifecycle ────────────────────────────────────────
  // The engine-level lifecycle. Each CRD has its own conditions but
  // the engine's health is reported via these.

  status: { ready: Bool, customerCount: Nat, productCount: Nat }
  conditions: ["Ready", "CustomerNamespaceExists", "CRDsEstablished", "ReconcilerHealthy"]
  finalizers: ["cleanup-customer-namespaces", "cleanup-build-job-pvcs"]
  ownerReferences: false

  // ─── Formal spec ────────────────────────────────────────────────
  // The invariants the engine must maintain.

  constraint "every product has a customer" {
    forall p in products.values():
      customers.has(p.spec.customerRef)
  }

  constraint "every product has a spec" {
    forall p in products.values():
      specs.has(p.spec.specRef)
  }

  constraint "every buildjob references a product" {
    forall bj in buildJobs.values():
      products.has(bj.spec.productRef)
  }

  constraint "every acceptance contract has a customer" {
    forall ac in acceptanceContracts.values():
      customers.has(ac.spec.customerRef)
  }

  constraint "every evaluator has a customer" {
    forall e in evaluators.values():
      customers.has(e.spec.customerRef)
  }

  constraint "every integration has a customer" {
    forall i in integrations.values():
      customers.has(i.spec.customerRef)
  }

  constraint "flow initial state is in states list" {
    forall f in flows.values():
      f.spec.states.contains(f.spec.initialState)
  }

  constraint "shipped products have a tomlPath" {
    forall p in products.values():
      p.status.phase != Shipped || p.status.tomlPath != null
  }

  // ─── Provenance ────────────────────────────────────────────────
  // The lineage of this spec. TEF itself is the dogfood target — the
  // engine consumes CRDs that this spec defines.

  provenance {
    parent_spec "speckl-ir.speckdl"
    external_doc "Kubernetes API Conventions" :: "https://github.com/kubernetes/community/blob/master/contributors/devel/sig-architecture/api-conventions.md"
    external_doc "kubebuilder book" :: "https://book.kubebuilder.io/"
    external_doc "controller-runtime API" :: "https://pkg.go.dev/sigs.k8s.io/controller-runtime"
    external_doc "K8s CustomResourceDefinition" :: "https://kubernetes.io/docs/tasks/extend-kubernetes/custom-resources/custom-resource-definitions/"
    design_decision "8 CRDs, not fewer" :: "Customer/Product/Spec/Flow/AcceptanceContract/BuildJob/Integration/Evaluator — each represents a distinct concern; merging them would couple unrelated lifecycles"
    design_decision "expression is shell command in v1" :: "TODO: real evaluator — Speckl typed expression trees will replace raw shell commands in a later slice"
    design_decision "ObjectMeta is hand-modeled" :: "subset of metav1.ObjectMeta covering the fields TEF actually uses; the K8s CRD target will generate the full ObjectMeta inline"
    design_decision "wire_format is dual" :: "protobuf for service-to-service, CRD YAML for K8s API registration; the K8s CRD target emits the CRD definitions, protobuf target emits the gRPC service"
    design_decision "provenance is non-optional" :: "every CRD inherits lineage from this spec; the K8s CRD target will emit the `metadata.annotations[kubernetes.io/description]` field from provenance clauses"
  }

  // ─── BOM metadata ──────────────────────────────────────────────

  bom {
    compiler { name: "speckl", version: "0.3.0" }
    runtime { name: "node", version: "20" }
    license: "MIT"
  }
}
