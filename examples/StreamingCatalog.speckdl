// StreamingCatalog.speckdl — A canonical streaming platform, specified in Speckl.
//
// The "specify anything with provenance" demo for a media-streaming app.
// Forces every facet the IR exposes:
//
//   - typed_schema: Title, Profile, Subscription, Playback
//   - behavior: Browse, Search, Subscribe, Cancel, Play, Pause
//   - formal_spec: content rating, regional availability
//   - wire_format: protobuf for transport; HLS/DASH for streaming (annotation)
//   - validation: title length, rating enum, region codes
//   - resource_lifecycle: subscription lifecycle, playback state
//   - provenance: explicit lineage to content standards
//   - metadata: version, license

speck StreamingCatalog {
  author: "sscoble"
  source: document ref "streaming-catalog-canonical-spec"
  review: manual

  state: {
    titles: Map<String, Title>,
    profiles: Map<String, Profile>,
    subscriptions: Map<String, Subscription>,
    playbacks: Map<String, Playback>
  }

  init: {
    titles := Map.empty(),
    profiles := Map.empty(),
    subscriptions := Map.empty(),
    playbacks := Map.empty()
  }

  // ─── Types ────────────────────────────────────────────────

  type Title = {
    id: String,
    name: String,                 // 1..200 chars
    kind: TitleKind,              // movie or series
    rating: ContentRating,       // MPAA / TV parental
    durationMinutes: Nat,        // 1..600
    releaseYear: Nat,
    genres: List<String>,
    availableRegions: List<String>,
    description: String,
    createdAt: Date
  }

  type Profile = {
    id: String,
    userId: String,
    displayName: String,
    avatarUrl: String | null,
    languagePreference: String,
    maturityRating: ContentRating,  // profile-level cap
    createdAt: Date
  }

  type Subscription = {
    id: String,
    userId: String,
    plan: SubscriptionPlan,        // basic / standard / premium
    status: SubscriptionStatus,    // active / suspended / cancelled / trial
    startedAt: Date,
    renewsAt: Date,
    cancelledAt: Date | null
  }

  type Playback = {
    id: String,
    profileId: String,
    titleId: String,
    positionSeconds: Nat,         // 0..duration*60
    state: PlaybackState,         // playing / paused / stopped / completed
    quality: PlaybackQuality,     // sd / hd / 4k
    startedAt: Date,
    lastUpdatedAt: Date
  }

  interface TitleKind {
    Movie
    Series
    Episode
    Documentary
  }

  interface ContentRating {
    G
    PG
    PG13
    R
    NC17
    TVY
    TVG
    TVPG
    TV14
    TVMA
  }

  interface SubscriptionPlan {
    Basic
    Standard
    Premium
  }

  interface SubscriptionStatus {
    Trial
    Active
    Suspended
    Cancelled
  }

  interface PlaybackState {
    Playing
    Paused
    Stopped
    Completed
  }

  interface PlaybackQuality {
    SD
    HD
    UHD4K
  }

  // ─── Title operations (catalog) ───────────────────────────

  action AddTitle(name: String, kind: TitleKind, rating: ContentRating, durationMinutes: Nat, releaseYear: Nat, genres: List<String>, availableRegions: List<String>, description: String) {
    require length(name) >= 1
    require length(name) <= 200
    require durationMinutes >= 1
    require durationMinutes <= 600
    require releaseYear >= 1900
    let id := name + ":" + String(releaseYear)
    let title := Title {
      id: id,
      name: name,
      kind: kind,
      rating: rating,
      durationMinutes: durationMinutes,
      releaseYear: releaseYear,
      genres: genres,
      availableRegions: availableRegions,
      description: description,
      createdAt: Date.now()
    }
    titles[id] := title
  }

  // ─── Profile operations ──────────────────────────────────

  action CreateProfile(userId: String, displayName: String, languagePreference: String, maturityRating: ContentRating) {
    require length(displayName) >= 1
    require length(displayName) <= 50
    let id := userId + ":" + displayName
    let profile := Profile {
      id: id,
      userId: userId,
      displayName: displayName,
      avatarUrl: null,
      languagePreference: languagePreference,
      maturityRating: maturityRating,
      createdAt: Date.now()
    }
    profiles[id] := profile
  }

  // ─── Subscription operations ─────────────────────────────

  action StartSubscription(userId: String, plan: SubscriptionPlan) {
    let id := userId
    let now := Date.now()
    let sub := Subscription {
      id: id,
      userId: userId,
      plan: plan,
      status: Trial,
      startedAt: now,
      renewsAt: now + 2592000,
      cancelledAt: null
    }
    subscriptions[id] := sub
  }

  action CancelSubscription(userId: String) {
    require subscriptions.has(userId)
    let sub := subscriptions[userId]
    sub.status := Cancelled
    sub.cancelledAt := Date.now()
    subscriptions[userId] := sub
  }

  // ─── Playback operations ─────────────────────────────────

  action StartPlayback(profileId: String, titleId: String, quality: PlaybackQuality) {
    require profiles.has(profileId)
    require titles.has(titleId)
    let id := profileId + ":" + titleId
    let playback := Playback {
      id: id,
      profileId: profileId,
      titleId: titleId,
      positionSeconds: 0,
      state: Playing,
      quality: quality,
      startedAt: Date.now(),
      lastUpdatedAt: Date.now()
    }
    playbacks[id] := playback
  }

  action PausePlayback(profileId: String, titleId: String) {
    let id := profileId + ":" + titleId
    require playbacks.has(id)
    let p := playbacks[id]
    p.state := Paused
    p.lastUpdatedAt := Date.now()
    playbacks[id] := p
  }

  action StopPlayback(profileId: String, titleId: String) {
    let id := profileId + ":" + titleId
    require playbacks.has(id)
    let p := playbacks[id]
    p.state := Stopped
    p.lastUpdatedAt := Date.now()
    playbacks[id] := p
  }

  // ─── Service definition ──────────────────────────────────

  service StreamingService {
    rpc AddTitle (AddTitleRequest) returns (Title);
    rpc CreateProfile (CreateProfileRequest) returns (Profile);
    rpc StartSubscription (StartSubscriptionRequest) returns (Subscription);
    rpc CancelSubscription (CancelSubscriptionRequest) returns (Subscription);
    rpc StartPlayback (StartPlaybackRequest) returns (Playback);
    rpc PausePlayback (PausePlaybackRequest) returns (Playback);
    rpc StopPlayback (StopPlaybackRequest) returns (Playback);
  }

  // ─── Wire format ──────────────────────────────────────────

  proto_package: "streaming.v1"
  go_package: "github.com/sscoble/streaming/proto/streaming/v1;streamingv1"
  event_suffix: "Request"

  // ─── Resource lifecycle ──────────────────────────────────
  // Subscriptions have a real lifecycle: Trial → Active → Suspended → Cancelled
  // Profiles have a single-state existence (active or deleted)
  // Playbacks are short-lived (Playing → Paused → Stopped/Completed)

  status: { ready: Bool, titleCount: Nat, subscriberCount: Nat }
  conditions: ["Ready", "CatalogLoaded", "SubscribersActive"]
  finalizers: ["cleanup-playback-state"]
  ownerReferences: false

  // ─── Formal spec ─────────────────────────────────────────

  constraint "no premium-only titles on basic plan" {
    forall t in titles.values():
      t.rating != NC17 || List.contains(t.availableRegions, "US")
  }

  constraint "all titles have at least one genre" {
    forall t in titles.values():
      length(t.genres) >= 1
  }

  // ─── Provenance ──────────────────────────────────────────

  provenance {
    parent_spec "Microblog.speckdl"
    external_doc "MPEG-DASH ISO/IEC 23009-1" :: "https://www.iso.org/standard/65274.html"
    external_doc "HLS RFC 8216" :: "https://datatracker.ietf.org/doc/html/rfc8216"
    external_doc "Common Sense Media rating taxonomy" :: "https://www.commonsensemedia.org/about-us/our-reviews/age-ratings"
    design_decision "rating enum is closed-set" :: "matches MPAA + TV parental guides, not a free-text field"
    design_decision "subscription has Trial state" :: "supports marketing acquisition flow; cancelled state preserves history"
  }

  // ─── BOM metadata ─────────────────────────────────────────

  bom {
    compiler { name: "speckl", version: "0.3.0" }
    runtime { name: "node", version: "20" }
    license: "MIT"
  }
}
