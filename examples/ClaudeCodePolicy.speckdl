speck ClaudeCodePolicy {
    // AgentPolicy, wired into Claude Code and Cursor through their hooks.
    // The agent may edit and test freely. It may not commit for review until
    // the tests pass, and it may not push or open a PR until a human approves.
    // Any edit after that throws the approval away. Tool calls that match no
    // `map` line are denied.

    state {
        stage: Nat
        testsPassed: Bool
        prFromApproved: Bool
    }

    init {
        stage := 0
        testsPassed := false
        prFromApproved := false
    }

    invariant PrNeedsGreenTests {
        stage != 5 or testsPassed
    }

    invariant PrNeedsApproval {
        stage != 5 or prFromApproved
    }

    // Editing resets the run: tests and any approval no longer apply.
    action EditCode(path: String) {
        require stage != 2 and stage != 5
        testsPassed := false
        prFromApproved := false
        stage := 0
    }

    action RunTests {
        require stage == 0 or stage == 1
        testsPassed := true
        stage := 1
    }

    action RequestReview {
        require stage == 1 and testsPassed
        stage := 2
    }

    action OpenPR {
        require stage == 3
        prFromApproved := stage == 3
        stage := 5
    }

    action ReadFile(path: String) {
        return true
    }

    action Inspect {
        return true
    }

    agent {
        stages stage {
            Idle = 0
            TestsGreen = 1
            AwaitingReview = 2
            Approved = 3
            Rejected = 4
            PrOpened = 5
        }

        tool edit_code      -> EditCode       effect act
        tool run_tests      -> RunTests       effect act
        tool request_review -> RequestReview  effect act
        tool open_pr        -> OpenPR         effect act
        tool read_file      -> ReadFile       effect observe
        tool inspect        -> Inspect        effect observe

        await AwaitingReview {
            signal review
            mode near
            require outcome in { approve, reject! }
            require claims { reviewer: String }
            on approve -> Approved
            on reject  -> Rejected
            timeout 24h -> reject
        }

        harness claude-code {
            map Edit|Write|MultiEdit|NotebookEdit -> edit_code { path = file_path }
            map Read -> read_file { path = file_path }
            map Grep|Glob|LS|TodoWrite -> inspect
            map Bash command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map Bash command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map Bash command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map Bash command ~ "git commit -m \"[^\"]*\"" -> request_review
            map Bash command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
            map Bash command ~ "gh pr create( .*)?" -> open_pr
        }

        harness cursor {
            map Write|Delete -> edit_code { path = file_path }
            map Read -> read_file { path = file_path }
            map Grep|Glob|LS -> inspect
            map Shell command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map Shell command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map Shell command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map Shell command ~ "git commit -m \"[^\"]*\"" -> request_review
            map Shell command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
            map Shell command ~ "gh pr create( .*)?" -> open_pr
        }

        // Codex reports a Bash call's output but not its exit status, so a
        // Bash call can never count as a success there (fail closed): it is
        // allowed or denied as usual but never advances the policy. Run the
        // gates through MCP tools, whose results carry isError.
        harness codex {
            map apply_patch -> edit_code { path = path }
            map mcp__ci__run_tests -> run_tests
            map mcp__ci__request_review -> request_review
            map mcp__github__create_pull_request -> open_pr
            map update_plan -> inspect
            map Bash command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map Bash command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
        }

        harness gemini {
            map write_file|replace -> edit_code { path = file_path }
            map read_file -> read_file { path = file_path }
            map glob|grep_search|list_directory|write_todos -> inspect
            map run_shell_command command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map run_shell_command command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map run_shell_command command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map run_shell_command command ~ "git commit -m \"[^\"]*\"" -> request_review
            map run_shell_command command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
        }

        // GitHub Copilot CLI / cloud agent. A bash result counts as a success
        // only when it ends with `<exited with exit code 0>`.
        harness copilot {
            map create|edit -> edit_code { path = path }
            map apply_patch -> edit_code { path = path }
            map view -> read_file { path = path }
            map grep|glob -> inspect
            map bash command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map bash command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map bash command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map bash command ~ "git commit -m \"[^\"]*\"" -> request_review
            map bash command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
        }

        // Goose (developer extension tools arrive under their bare names).
        harness goose {
            map write|edit -> edit_code { path = path }
            map tree -> inspect
            map shell command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map shell command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map shell command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map shell command ~ "git commit -m \"[^\"]*\"" -> request_review
            map shell command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
        }

        // Hermes Agent. A terminal call counts as a success only when its
        // result reports exit_code 0.
        harness hermes {
            map write_file|patch -> edit_code { path = path }
            map read_file -> read_file { path = path }
            map search_files -> inspect
            map terminal command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map terminal command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map terminal command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map terminal command ~ "git commit -m \"[^\"]*\"" -> request_review
            map terminal command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
        }

        // Pi (pi.dev). A bash result counts as a success only when pi reports
        // isError false and structuredContent.exit_code 0.
        harness pi {
            map write|edit -> edit_code { path = path }
            map read -> read_file { path = path }
            map grep|find|ls -> inspect
            map bash command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map bash command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map bash command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map bash command ~ "git commit -m \"[^\"]*\"" -> request_review
            map bash command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
        }

        // OpenCode 1.x. A bash result counts as a success only with metadata.exit 0.
        harness opencode {
            map write|edit -> edit_code { path = filePath }
            map apply_patch -> edit_code { path = path }
            map read -> read_file { path = filePath }
            map grep|glob|todowrite -> inspect
            map bash command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map bash command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map bash command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map bash command ~ "git commit -m \"[^\"]*\"" -> request_review
            map bash command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
        }

        // OpenClaw. An exec result counts as a success only with details
        // {status: "completed", exitCode: 0}.
        harness openclaw {
            map write|edit -> edit_code { path = path }
            map apply_patch -> edit_code { path = path }
            map read -> read_file { path = path }
            map ls -> inspect
            map exec command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map exec command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map exec command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map exec command ~ "git commit -m \"[^\"]*\"" -> request_review
            map exec command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
        }

        // Cline (CLI 3.x and the VS Code extension). run_commands maps only
        // when it carries a single plain command; a shell result counts as a
        // success only when every command entry reports success: true.
        harness cline {
            map editor -> edit_code { path = path }
            map apply_patch -> edit_code { path = path }
            map read_files|search_codebase -> inspect
            map run_commands command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map run_commands command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map run_commands command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map run_commands command ~ "git commit -m \"[^\"]*\"" -> request_review
            map run_commands command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
        }

        // Kiro (IDE 1.x and CLI V3, .kiro/hooks/*.json). Kiro reports no
        // success flag: a shell result counts only with a final "Exit Code: 0".
        harness kiro {
            map fs_write|fs_append|str_replace|write -> edit_code { path = path }
            map read_file|fs_read|read -> read_file { path = path }
            map list_directory|file_search|grep_search -> inspect
            map execute_bash|shell command ~ "npm (run )?test( -- [A-Za-z0-9_./=-]+)*" -> run_tests
            map execute_bash|shell command ~ "git (status|diff|log)( [A-Za-z0-9_./=-]+)*" -> inspect
            map execute_bash|shell command ~ "git add( [A-Za-z0-9_./-]+)+" -> inspect
            map execute_bash|shell command ~ "git commit -m \"[^\"]*\"" -> request_review
            map execute_bash|shell command ~ "git push( -u)? origin [A-Za-z0-9_./-]+" -> open_pr
        }
    }

    next: EditCode | RunTests | RequestReview | OpenPR | ReadFile | Inspect

    verify Always(PrNeedsGreenTests) {
        depth 8
    }

    verify Always(PrNeedsApproval) {
        depth 8
    }
}
