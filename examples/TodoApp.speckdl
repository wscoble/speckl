// TodoApp.speckdl — A canonical todo-list application, specified in Speckl.
//
// The smallest "specify anything with provenance" demo. The app has no
// interesting state machine — items are independent — so this spec
// exercises typed_schema + behavior (CRUD actions) + provenance, but
// NOT the state-machine facet.
//
// This version uses only syntax the existing Speckl parser handles.
// Newer facets (validation, resource_lifecycle) are exposed via the
// IR for future use but not declared in the source yet.

speck TodoApp {
  author: "wscoble"
  source: document ref "eloquent-javascript-chapter-4"
  review: manual

  // ─── Purpose ──────────────────────────────────────────────
  // A list of todo items. Each item has text and a done flag.
  // CRUD: create, get, list, complete, delete.

  // ─── State ────────────────────────────────────────────────
  // items: the in-memory store, keyed by id.

  state: {
    items: Map<String, TodoItem>,
    nextId: Nat := 1
  }

  init: {
    items := Map.empty(),
    nextId := 1
  }

  // ─── Types ────────────────────────────────────────────────
  // TodoItem is the only record.

  type TodoItem = {
    id: String,
    text: String,
    done: Bool,
    createdAt: Date
  }

  // ─── Operations ──────────────────────────────────────────
  // Each operation is an action. The action's require/postcondition
  // is the spec-level contract.

  action CreateTodo(text: String) {
    require length(text) >= 1
    let newId := nextId
    nextId := nextId + 1
    let item := TodoItem { id: String(newId), text: text, done: false, createdAt: Date.now() }
    items[newId] := item
  }

  action GetTodo(id: String) {
    require items.has(id)
    return items[id]
  }

  action ListTodos() {
    return items.values()
  }

  action CompleteTodo(id: String) {
    require items.has(id)
    let item := items[id]
    item.done := true
    items[id] := item
  }

  action DeleteTodo(id: String) {
    require items.has(id)
    items.remove(id)
  }

  // ─── Constraints ──────────────────────────────────────────
  // Spec-level invariants. The IR captures these as typed expression
  // trees; the Z3 generator can verify them offline.

  constraint "nextId is always positive" {
    nextId > 0
  }

  // ─── Service definition (for transport / OpenAPI) ────────
  // The TodoService is the public API surface. Each method is an
  // RPC. OpenAPI generation reads this block directly.

  service TodoService {
    rpc CreateTodo (CreateTodoRequest) returns (TodoItem);
    rpc GetTodo (GetTodoRequest) returns (TodoItem);
    rpc ListTodos (ListTodosRequest) returns (ListTodosResponse);
    rpc CompleteTodo (CompleteTodoRequest) returns (TodoItem);
    rpc DeleteTodo (DeleteTodoRequest) returns (DeleteTodoResponse);
  }

  // ─── Wire format ──────────────────────────────────────────
  // Protobuf-specific overrides.

  proto_package: "todo.v1"
  go_package: "github.com/wscoble/todo-app/proto/todo/v1;todov1"
  event_suffix: "Request"

  // ─── Resource lifecycle (K8s CRD target) ─────────────────
  // The K8s target reads this block. todos.tef.scoble.me has:
  //   - status subresource with {ready, itemCount}
  //   - condition types for the controller to emit
  //   - no finalizers (CRUD is simple, no async cleanup)
  //   - no owner references (todo items are first-class, not children)

  status: { ready: Bool, itemCount: Nat }
  conditions: ["Ready", "ItemsLoaded"]
  finalizers: []
  ownerReferences: false

  // ─── Provenance ──────────────────────────────────────────
  // Per the "with provenance" requirement, this block is required
  // in any Speckl spec targeting a build pipeline. The IR pass
  // synthesizes one from file metadata if absent — but explicit
  // is better than synthesized.

  provenance {
    regulation "no-PII-policy" :: "checked at acceptance"
    design_decision "items are independent, not hierarchical" :: "matches Eloquent JavaScript tutorial scope"
    parent_spec "speckl-ir.speckdl"
    external_doc "Eloquent JavaScript Ch 4" :: "https://eloquentjavascript.net/04_data.html"
  }

  // ─── BOM metadata ─────────────────────────────────────────

  bom {
    compiler { name: "speckl", version: "0.3.0" }
    solver { name: "z3", version: "4.12.2" }
    runtime { name: "node", version: "20" }
    license: "MIT"
  }
}
