{
  "name": "speckl-studio",
  "version": "0.1.0",
  "description": "Local conversational studio for developing SpeckDL behavior specifications with an AI partner",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.ts",
    "dev": "node --watch server/index.ts",
    "build:editor": "esbuild web/editor-src.js --bundle --outfile=web/vendor/cm.js --format=iife --global-name=SpecklEditor --minify --alias:@speckl/parser=${SPECKL_PARSER:-$HOME/Projects/speckl/compiler/src/parser.ts} --alias:fs=./web/shims/empty.js --alias:path=./web/shims/empty.js",
    "serve": "node serve.ts"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1"
  }
}
